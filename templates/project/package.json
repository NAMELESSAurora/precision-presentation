{
  "name": "presentation",
  "private": true,
  "version": "1.0.0",
  "description": "HTML presentation (precision-presentation scaffold; plain HTML/CSS/JS, no build step)",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/copy-diff.test.mjs && playwright test",
    "notes": "node scripts/build-notes.mjs",
    "test:unit": "node --test tests/copy-diff.test.mjs",
    "qa:shots": "node scripts/qa-shots.mjs",
    "qa:motion": "node scripts/qa-motion.mjs",
    "qa:media": "node scripts/qa-media.mjs",
    "qa:layout": "node scripts/qa-layout.mjs qa/layout-report.json --gate",
    "qa:layout:static": "node scripts/qa-layout.mjs qa/layout-static.json --static --gate",
    "qa:layout:mid": "node scripts/qa-layout.mjs qa/layout-mid.json --views 1920x1080,1280x720 --mid --gate",
    "qa:type": "node scripts/qa-type.mjs qa/type-census.json --gate",
    "qa:design": "node scripts/qa-design.mjs",
    "qa:handoff": "node scripts/qa-handoff.mjs qa/handoff.json",
    "qa:run": "node scripts/qa-run.mjs qa/motion-run",
    "qa:frames": "node scripts/qa-frames.mjs",
    "qa:strip": "node scripts/qa-strip.mjs",
    "qa:copy": "node scripts/qa-copy-moved.mjs",
    "qa:preview": "node scripts/qa-preview.mjs",
    "qa:compare": "node scripts/qa-compare.mjs",
    "qa:endsheet": "node scripts/qa-endsheet.mjs",
    "qa:gate": "npm run qa:layout && npm run qa:layout:static && npm run qa:layout:mid && npm run qa:type && npm run qa:design",
    "export:pdf": "node scripts/export-pdf.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run qa:gate && node scripts/build-notes.mjs && node scripts/export-pdf.mjs && node scripts/build.mjs && node scripts/verify-dist.mjs release && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
